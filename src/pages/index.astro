---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// latest 3 published articles for the homepage teaser
const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const catLabel = { 'SEO & AEO': 'Essay', 'Content': 'Playbook', 'Growth': 'Playbook', 'Lifecycle': 'Teardown', 'Wealth & Fintech': 'Field notes' };
---
<BaseLayout
  title="Ankur Tripathi — Growth & Content Marketing"
  description="Senior growth and content marketing leader — fractional, project or full-time. A decade building demand for AI, SaaS, wealth and fintech products across SEO/AEO, content, lifecycle, martech and the full funnel." 
  path="/"
  type="website"
>
<!-- HERO -->
<header id="top">
  <div class="wrap">
    <div class="hero-grid">
      <div class="hero">
        <span class="eyebrow reveal in">Growth & Content Marketing</span>
        <h1 class="reveal in d1">I help products get <em>found</em>, <em>understood</em>, and <em>chosen</em>.</h1>
        <p class="lead reveal in d2">Senior growth & content marketing leader. A decade turning complex products — from investing platforms to early-stage AI — into clear, compounding demand across search, answer engines, lifecycle and the full funnel.</p>
        <div class="hero-cta reveal in d3">
          <a href="#contact" class="btn">Start a project</a>
          <a href="#services" class="btn-ghost">See how I work</a>
        </div>
      </div>
      <div class="hero reveal in d2">
        <div class="portrait-frame">
          <div class="portrait"><span class="initials">AT</span></div>
          <div class="portrait-tag">
            <div class="mono">Open to new work</div>
            <div class="name">Fractional · Project · Full-time</div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="strip">
    <div class="strip-track">
      <span>SEO &amp; AEO Strategy</span><span>Content Engines</span><span>Lifecycle &amp; CRM</span><span>Performance Marketing</span><span>Full-Funnel Growth</span>
      <span>SEO &amp; AEO Strategy</span><span>Content Engines</span><span>Lifecycle &amp; CRM</span><span>Performance Marketing</span><span>Full-Funnel Growth</span>
    </div>
  </div>
</header>

<!-- ABOUT -->
<section id="about">
  <div class="wrap">
    <div class="about-grid">
      <div class="about-side reveal">
        <div class="sec-num">01 — About</div>
        <h2 class="serif" style="font-weight:400;font-size:38px;line-height:1.1;letter-spacing:-.02em;margin:14px 0 30px;">Strategy that ships.</h2>
        <div class="label">Disciplines</div>
        <div class="chip-row">
          <span class="chip">SEO / AEO</span><span class="chip">Content Strategy</span><span class="chip">Lifecycle &amp; CRM</span><span class="chip">Performance</span><span class="chip">Organic Social</span><span class="chip">Analytics &amp; Martech</span><span class="chip">Product &amp; Pricing</span><span class="chip">Team &amp; Agency Leadership</span>
        </div>
        <div class="label">Best for</div>
        <div class="chip-row">
          <span class="chip">Early-stage &amp; AI products</span><span class="chip">SaaS &amp; growth-stage</span><span class="chip">Wealth &amp; fintech</span><span class="chip">US &amp; global markets</span><span class="chip">Founders &amp; lean teams</span>
        </div>
        <div class="label">Ways to work together</div>
        <div class="chip-row">
          <span class="chip">Fractional</span><span class="chip">Project</span><span class="chip">Full-time</span>
        </div>
      </div>
      <div class="about-body reveal d1">
        <p>For over a decade I've led growth for products that are hard to explain — the kind where <strong>trust, clarity, and timing</strong> decide whether someone signs up or scrolls past.</p>
        <p>I work across the full funnel: search and AI answer engines, content, lifecycle and CRM, paid, and organic social. I stay hands-on with the tools that make it measurable — GA4, Search Console, email and push platforms, and the wider martech stack — so decisions come from data, not opinion.</p>
        <p>I also sit close to product: shaping prototypes, running launches, keeping products healthy after launch, and making the pricing and discount calls that quietly decide whether growth is profitable.</p>
        <p>Much of my depth comes from <strong>wealth, investing and financial products</strong> — some of the most regulated, trust-heavy categories there are. I treat that as depth, not a boundary: the same playbook works for any complex, considered purchase.</p>
        <p>Right now I lead growth for two early-stage <strong>AI products built for the US market</strong> — one in stock research, one in healthcare for physicians working with electronic health records. Different industries, same job: make something new feel clear, credible and worth trying. I work at founder level on both, which means owning the strategy and shipping it.</p>
        <p>And I build the teams that ship it — in-house and agency — across copywriting, design and video, so strategy doesn't stop at the deck.</p>
      </div>
    </div>
  </div>
</section>

<!-- SERVICES -->
<section id="services">
  <div class="wrap">
    <div class="sec-head reveal">
      <div class="sec-num">02 — What I do</div>
      <h2>Four ways I help teams grow — together or à la carte.</h2>
    </div>
    <div class="svc-grid">
      <div class="svc reveal"><div class="svc-num">/ 01</div><h3>SEO &amp; AEO Strategy</h3><p>Be the answer, not just a result. Technical and editorial SEO built for Google <em>and</em> the AI answer engines — AI Overviews, ChatGPT, Perplexity — that increasingly decide what gets seen and cited.</p><div class="arrow">→</div></div>
      <div class="svc reveal d1"><div class="svc-num">/ 02</div><h3>Content Engine</h3><p>Blogs, carousels, infographics, short-form video — a repeatable system that produces, distributes, and measures content, instead of a calendar of one-off posts that go nowhere.</p><div class="arrow">→</div></div>
      <div class="svc reveal d2"><div class="svc-num">/ 03</div><h3>Full-Funnel &amp; Martech</h3><p>Performance, lifecycle and CRM working as one system — wired into GA4, Search Console and your email, push and automation tools, so you can see what converts and what to fix.</p><div class="arrow">→</div></div>
      <div class="svc reveal d3"><div class="svc-num">/ 04</div><h3>Growth Leadership</h3><p>Senior marketing direction — fractional, on a project, or full-time. Strategy, product and pricing input, and leading in-house and agency teams across copy, design and video.</p><div class="arrow">→</div></div>
    </div>
  </div>
</section>

<!-- WRITING TEASER (auto-pulls latest posts) -->
<section id="writing">
  <div class="wrap">
    <div class="sec-head reveal">
      <div class="sec-num">03 — Writing</div>
      <h2>Notes on growth, content, and the new search.</h2>
    </div>
    <div class="write-grid">
      {articles.length === 0 && (
        <p style="color:rgba(244,239,230,.6)">Your latest posts will appear here once you publish them in the CMS.</p>
      )}
      {articles.map((post) => (
        <a href={`/articles/${post.id}/`} class="post reveal">
          <span class="cat">{catLabel[post.data.category] ?? 'Essay'}</span>
          <h3>{post.data.title}</h3>
          <p>{post.data.description}</p>
          <span class="meta">{post.data.readTime ?? 'Read'}</span>
        </a>
      ))}
    </div>
    <p class="write-note">Browse everything in the <a href="/writing/" style="color:var(--clay);border-bottom:1px solid var(--clay);">Writing &amp; Work hub →</a> — articles in one place, carousels &amp; infographics in another.</p>
  </div>
</section>

<!-- CONTACT -->
<section id="contact">
  <div class="wrap">
    <div class="contact-grid">
      <div class="contact-left reveal">
        <div class="sec-num">04 — Contact</div>
        <h2 style="margin-top:14px;">Tell me what you're trying to grow.</h2>
        <p class="lead">Whether it's a content engine from scratch, an SEO/AEO overhaul, or fractional marketing leadership — share a few details and I'll reply within two business days.</p>
        <div class="contact-detail"><div class="label">Email</div><a href="mailto:info@ankurtripathi.net">info@ankurtripathi.net</a></div>
        <div class="contact-detail"><div class="label">Based in</div><span>Indore, India · Working with teams everywhere</span></div>
        <div class="socials">
          <a href="https://www.linkedin.com/in/ankur-tripathi-359ab72" target="_blank" rel="noopener" class="social" aria-label="LinkedIn"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14zM8.34 9.5H5.67V18h2.67V9.5zM7 6.16a1.55 1.55 0 1 0 0 3.1 1.55 1.55 0 0 0 0-3.1zM18.34 18v-4.67c0-2.5-1.34-3.67-3.12-3.67-1.44 0-2.08.79-2.44 1.35V9.5h-2.67V18h2.67v-4.5c0-1.18.22-2.32 1.68-2.32 1.44 0 1.46 1.34 1.46 2.4V18h2.42z"/></svg></a>
          <a href="https://x.com/ankur2987" target="_blank" rel="noopener" class="social" aria-label="X"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.9 2H22l-7.5 8.6L23 22h-6.8l-5.3-7-6.1 7H1.6l8-9.2L1 2h7l4.8 6.3L18.9 2zm-2.4 18h1.9L7.6 4h-2l11 16z"/></svg></a>
        </div>
      </div>
      <div>
        <form id="enquiryForm">
          <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
          <div class="field"><label>Your name <span class="req">*</span></label><input type="text" name="name" required placeholder="Jane Doe" /></div>
          <div class="field-row">
            <div class="field"><label>Email <span class="req">*</span></label><input type="email" name="email" required placeholder="jane@company.com" /></div>
            <div class="field"><label>Company</label><input type="text" name="company" placeholder="Acme Inc." /></div>
          </div>
          <div class="field"><label>What do you need help with? <span class="req">*</span></label>
            <select name="need" required><option value="">Select one…</option><option>SEO &amp; AEO strategy</option><option>Content engine (blog / social / design)</option><option>Full-funnel growth</option><option>Fractional marketing leadership</option><option>A full-time role on your team</option><option>Something else</option></select>
          </div>
          <div class="field"><label>Project details</label><textarea name="details" placeholder="A couple of lines on your product, goals, and timeline…"></textarea></div>
          <div class="field"><label>Indicative budget</label>
            <select name="budget"><option value="">Prefer not to say</option><option>Under $1k / month</option><option>$1k–3k / month</option><option>$3k–7k / month</option><option>Project-based</option></select>
          </div>
          <button type="submit" class="submit-btn">Send enquiry →</button>
        </form>
        <div class="form-msg" id="formMsg">
          <div class="tick">✓</div>
          <h3>Thanks — message received.</h3>
          <p>I'll get back to you within two business days. A confirmation is on its way to your inbox.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  // scroll reveal
  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
  }, { threshold: 0.12 });
  document.querySelectorAll('.reveal').forEach(el => io.observe(el));

  // ===== ENQUIRY FORM → Google Sheet (Apps Script) =====
  // Paste your Apps Script Web App URL between the quotes below.
    const SHEET_ENDPOINT = "https://script.google.com/macros/s/AKfycbyHeBE6EQ84bCC-Hr0UjcT6Q8JNPszO_nAI0aXi_3QZvzk51h7VsreYZSdq83Jk3Fdl0A/exec";
  const form = document.getElementById('enquiryForm');
  const formMsg = document.getElementById('formMsg');
  if (form) form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (form._gotcha.value) return;
    const btn = form.querySelector('.submit-btn');
    btn.textContent = 'Sending…'; btn.disabled = true;
    try {
      await fetch(SHEET_ENDPOINT, { method: 'POST', mode: 'no-cors', body: new FormData(form) });
      form.style.display = 'none'; formMsg.classList.add('show');
    } catch (err) {
      btn.textContent = 'Send enquiry →'; btn.disabled = false;
      alert('Something went wrong — please email me directly at info@ankurtripathi.net');
    }
  });
</script>
</BaseLayout>
