---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Thanks — Ankur Tripathi"
  description="Your enquiry has been received."
  path="/thanks/"
  showChrome={false}
>
<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;text-align:center;padding:28px;">
  <div style="max-width:540px;">
    <div class="tick" style="width:64px;height:64px;background:var(--sage);color:var(--paper);border-radius:100px;display:inline-flex;align-items:center;justify-content:center;font-size:32px;margin-bottom:28px;">✓</div>
    <div class="eyebrow">Message received</div>
    <h1 class="serif" style="font-weight:400;font-size:clamp(34px,6vw,52px);line-height:1.05;letter-spacing:-.02em;margin:16px 0 18px;">Thanks — I'll be in touch.</h1>
    <p style="font-size:18px;color:var(--ink-soft);line-height:1.6;margin-bottom:34px;">Your enquiry has landed, and a confirmation is on its way to you. I reply to everything within two business days.</p>
    <a href="/" class="btn">← Back to home</a>
  </div>
</div>
</BaseLayout>
