---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });

const articleItems = (await getCollection('articles', ({ data }) => !data.draft)).map((p) => ({
  type: 'article', title: p.data.title, category: p.data.category,
  excerpt: p.data.description, date: fmt(p.data.pubDate), readTime: p.data.readTime ?? '',
  url: `/articles/${p.id}/`, cover: p.data.cover ?? '', images: [] as string[],
  ts: p.data.pubDate.valueOf(),
}));
const visualItems = (await getCollection('visuals', ({ data }) => !data.draft)).map((p) => ({
  type: p.data.type, title: p.data.title, category: p.data.category,
  excerpt: '', date: fmt(p.data.pubDate), readTime: '',
  url: '', cover: p.data.cover ?? '', images: p.data.images ?? [],
  ts: p.data.pubDate.valueOf(),
}));
const CONTENT = [...articleItems, ...visualItems].sort((a, b) => b.ts - a.ts);
const CATEGORIES = ['SEO & AEO', 'Content', 'Growth', 'Lifecycle', 'Wealth & Fintech'];
---
<BaseLayout
  title="Writing & Work — Ankur Tripathi"
  description="Essays, playbooks, carousels and infographics on growth, content, SEO/AEO and lifecycle marketing."
  path="/writing/"
>
<header style="padding:120px 0 30px">
  <div class="wrap">
    <span class="eyebrow">Writing &amp; Work</span>
    <h1 class="serif" style="font-weight:400;font-size:clamp(38px,6vw,68px);line-height:1.02;letter-spacing:-.02em;margin:22px 0 18px;">Ideas, playbooks &amp; visuals.</h1>
    <p class="lead" style="font-size:19px;color:var(--ink-soft);max-width:560px;">Long-form thinking on growth and content — plus the carousels and infographics I make to put those ideas to work.</p>
  </div>
</header>

<div class="controls">
  <div class="wrap">
    <div class="segments" id="segments">
      <button class="seg-btn active" data-seg="article">Articles</button>
      <button class="seg-btn" data-seg="visual">Carousels &amp; Infographics</button>
    </div>
    <div class="cats" id="cats"></div>
  </div>
</div>

<div class="wrap"><div class="grid" id="grid"></div></div>

<div class="lb" id="lb">
  <div class="lb-inner">
    <div class="lb-stage">
      <button class="lb-close" id="lbClose" aria-label="Close">&times;</button>
      <button class="lb-nav lb-prev" id="lbPrev" aria-label="Previous">&#8249;</button>
      <div class="lb-img-wrap" id="lbImgWrap"></div>
      <button class="lb-nav lb-next" id="lbNext" aria-label="Next">&#8250;</button>
    </div>
    <div class="lb-dots" id="lbDots"></div>
    <div class="lb-counter" id="lbCounter"></div>
    <div class="lb-title" id="lbTitle"></div>
  </div>
</div>

<script define:vars={{ CONTENT, CATEGORIES }}>
  const grid = document.getElementById('grid');
  const catsEl = document.getElementById('cats');
  let state = { seg: 'article', cat: 'All' };
  const gradients = [
    'linear-gradient(150deg,#1B1814,#2e2820 60%,#A23B1C)',
    'linear-gradient(150deg,#1B1814,#3a3328 55%,#5E6B52)',
    'linear-gradient(150deg,#A23B1C,#1B1814 70%)',
    'linear-gradient(150deg,#2e2820,#1B1814 60%,#C8502B)'
  ];
  const grad = i => gradients[i % gradients.length];

  function buildCats() {
    const all = ['All', ...CATEGORIES];
    catsEl.innerHTML = all.map(c => `<button class="cat-btn ${c === state.cat ? 'active' : ''}" data-cat="${c}">${c}</button>`).join('');
  }
  function thumb(item, i) {
    if (item.cover) return `<img src="${item.cover}" alt="${item.title}" loading="lazy">`;
    return `<div class="ph" style="background:${grad(i)}"><span>${item.title}</span></div>`;
  }
  function render() {
    buildCats();
    const isVisual = state.seg === 'visual';
    const list = CONTENT.filter(it => {
      const segOk = isVisual ? (it.type === 'carousel' || it.type === 'infographic') : it.type === 'article';
      const catOk = state.cat === 'All' || it.category === state.cat;
      return segOk && catOk;
    });
    if (!list.length) {
      grid.innerHTML = `<div class="empty">Nothing here yet. <span class="mono">→ Publish your first ${isVisual ? 'carousel or infographic' : 'article'} in the CMS.</span></div>`;
      return;
    }
    grid.innerHTML = list.map((item, i) => {
      const badge = item.type === 'article' ? 'Article' : (item.type === 'infographic' ? 'Infographic' : 'Carousel');
      const stack = (item.type === 'carousel' && item.images) ? `<div class="stack-hint">▦ ${item.images.length} slides</div>` : '';
      const body = item.type === 'article'
        ? `<p>${item.excerpt || ''}</p><div class="meta"><span>${item.date || ''}</span><span>${item.readTime || ''}</span></div>`
        : `<div class="meta"><span>${item.date || ''}</span></div>`;
      const idx = CONTENT.indexOf(item);
      return `<div class="card" data-idx="${idx}" data-type="${item.type}" ${item.url ? `data-url="${item.url}"` : ''}>
        <div class="thumb">${thumb(item, i)}<div class="badge">${badge}</div>${stack}</div>
        <div class="body"><span class="cat-tag">${item.category}</span><h3>${item.title}</h3>${body}</div></div>`;
    }).join('');
  }
  grid.addEventListener('click', e => {
    const card = e.target.closest('.card'); if (!card) return;
    if (card.dataset.type === 'article') { window.location.href = card.dataset.url || '#'; }
    else { openLightbox(CONTENT[card.dataset.idx]); }
  });
  document.getElementById('segments').addEventListener('click', e => {
    const b = e.target.closest('.seg-btn'); if (!b) return;
    document.querySelectorAll('.seg-btn').forEach(x => x.classList.remove('active'));
    b.classList.add('active'); state.seg = b.dataset.seg; state.cat = 'All'; render();
  });
  catsEl.addEventListener('click', e => {
    const b = e.target.closest('.cat-btn'); if (!b) return;
    state.cat = b.dataset.cat; render();
  });

  const lb = document.getElementById('lb');
  const lbImgWrap = document.getElementById('lbImgWrap');
  const lbDots = document.getElementById('lbDots');
  const lbCounter = document.getElementById('lbCounter');
  const lbTitle = document.getElementById('lbTitle');
  const lbPrev = document.getElementById('lbPrev');
  const lbNext = document.getElementById('lbNext');
  let lbState = { images: [], i: 0, title: '' };
  function showSlide() {
    const src = lbState.images[lbState.i];
    lbImgWrap.innerHTML = src
      ? `<img src="${src}" alt="${lbState.title}">`
      : `<div class="lb-ph" style="background:${grad(lbState.i)}"><span>${lbState.title}<br><small style="font-size:14px;opacity:.7">slide ${lbState.i + 1}</small></span></div>`;
    const multi = lbState.images.length > 1;
    lbPrev.style.display = lbNext.style.display = multi ? 'flex' : 'none';
    lbCounter.textContent = multi ? `${lbState.i + 1} / ${lbState.images.length}` : '';
    lbDots.innerHTML = multi ? lbState.images.map((_, k) => `<span class="${k === lbState.i ? 'on' : ''}"></span>`).join('') : '';
    lbTitle.textContent = lbState.title;
  }
  function openLightbox(item) {
    lbState = { images: (item.images && item.images.length) ? item.images : [''], i: 0, title: item.title };
    showSlide(); lb.classList.add('open'); document.body.style.overflow = 'hidden';
  }
  function closeLightbox() { lb.classList.remove('open'); document.body.style.overflow = ''; }
  lbPrev.addEventListener('click', () => { lbState.i = (lbState.i - 1 + lbState.images.length) % lbState.images.length; showSlide(); });
  lbNext.addEventListener('click', () => { lbState.i = (lbState.i + 1) % lbState.images.length; showSlide(); });
  document.getElementById('lbClose').addEventListener('click', closeLightbox);
  lb.addEventListener('click', e => { if (e.target === lb) closeLightbox(); });
  document.addEventListener('keydown', e => {
    if (!lb.classList.contains('open')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft' && lbState.images.length > 1) lbPrev.click();
    if (e.key === 'ArrowRight' && lbState.images.length > 1) lbNext.click();
  });
  render();
</script>
</BaseLayout>
